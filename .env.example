# GitHub CLI Token para conta pessoal (substitui usuário corporativo da máquina no script de PR)
GH_TOKEN=
GH_PERSONAL_TOKEN=

# Gemini API Key (Google AI Studio) para reviews locais de teste
GEMINI_API_KEY=

# Conta de teste (e-mail e senha) no Firebase real, para entrar no app local e nos previews.
# Usuário comum, não é super admin. Peça a senha ao dono do projeto; nunca a coloque em arquivo versionado.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
