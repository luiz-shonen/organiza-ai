rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.get('email', '')));
    }

    function isSuperAdmin() {
      let email = request.auth.token.get('email', '');
      return request.auth != null && (email == 'luiz.gmr.dev@gmail.com' || email == 'jessica.calm.dev@gmail.com');
    }

    match /admins/{email} {
      allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.token.get('email', '') == email);
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /family/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Collection group query for pending invitations
    match /{path=**}/invitations/{email} {
      allow read: if request.auth != null && (
        request.auth.token.get('email', '').lower() == email.lower()
        || (resource != null && resource.data.get('invitedEmail', '').lower() == request.auth.token.get('email', '').lower())
      );
    }

    // Events: public read, admin-only write
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Invitations subcollection: admin write, invited user read/delete
      match /invitations/{email} {
        allow read: if isAdmin() || (request.auth != null && request.auth.token.get('email', '').lower() == email.lower());
        allow create, update: if isAdmin();
        allow delete: if isAdmin() || (request.auth != null && request.auth.token.get('email', '').lower() == email.lower());
      }

      // Guests subcollection: public read, validated anonymous write
      match /guests/{guestId} {
        allow read: if true;
        allow create: if isAdmin() || isPrimaryRsvp() || isLinkedFamilyRsvp();
        allow update: if isAdmin() || (
                        request.auth != null
                        && ((resource.data.uid == request.auth.uid && isPrimaryRsvp())
                            || (resource.data.primaryGuestId == request.auth.uid && isLinkedFamilyRsvp()))
                      );
        allow delete: if isAdmin() || (
                        request.auth != null
                        && (resource.data.uid == request.auth.uid || resource.data.primaryGuestId == request.auth.uid)
                      );

        function isPrimaryRsvp() {
          return request.auth != null
              && request.resource.data.keys().hasAll(['name', 'phone', 'companionsCount', 'uid'])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.phone is string
              && request.resource.data.phone.size() >= 10
              && request.resource.data.companionsCount is int
              && request.resource.data.companionsCount >= 0
              && request.resource.data.companionsCount <= 10
              && (!request.resource.data.keys().hasAll(['companions'])
                  || (request.resource.data.companions is list
                      && request.resource.data.companions.size() == request.resource.data.companionsCount));
        }

        function isLinkedFamilyRsvp() {
          return request.auth != null
              && request.resource.data.keys().hasAll(['name', 'primaryGuestId', 'isConfirmed', 'confirmedAt'])
              && request.resource.data.primaryGuestId == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.isConfirmed == true
              && request.resource.data.confirmedAt is string;
        }
      }

      // Items subcollection: public read, admin create/delete, public claim/unclaim
      match /items/{itemId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
                        request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])
                        && (
                          // Claiming
                          (resource.data.claimedBy == null && request.resource.data.claimedBy != null && request.resource.data.claimedBy.uid == request.auth.uid)
                          // Unclaiming
                          || (resource.data.claimedBy != null && resource.data.claimedBy.uid == request.auth.uid && request.resource.data.claimedBy == null)
                        )
                      );
      }
    }
  }
}
