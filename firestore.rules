rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Events: public read, admin-only write
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Guests subcollection: public read, validated anonymous write
      match /guests/{guestId} {
        allow read: if true;
        allow create: if isAdmin() || (
                        request.auth != null
                        && request.resource.data.keys().hasAll(['name', 'phone', 'companionsCount', 'uid'])
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.name is string
                        && request.resource.data.name.size() > 0
                        && request.resource.data.phone is string
                        && request.resource.data.phone.size() >= 10
                        && request.resource.data.companionsCount is int
                        && request.resource.data.companionsCount >= 0
                      );
        allow update: if isAdmin() || (
                        request.auth != null
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.keys().hasAll(['name', 'phone'])
                        && request.resource.data.name is string
                        && request.resource.data.name.size() > 0
                        && request.resource.data.phone is string
                        && request.resource.data.phone.size() >= 10
                      );
        allow delete: if isAdmin() || (
                        request.auth != null
                        && resource.data.uid == request.auth.uid
                      );
      }

      // Items subcollection: public read, admin create/delete, public claim/unclaim
      match /items/{itemId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
                        request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])
                        && (
                          // Claiming
                          (resource.data.claimedBy == null && request.resource.data.claimedBy != null && request.resource.data.claimedBy.uid == request.auth.uid)
                          // Unclaiming
                          || (resource.data.claimedBy != null && resource.data.claimedBy.uid == request.auth.uid && request.resource.data.claimedBy == null)
                        )
                      );
      }
    }
  }
}
