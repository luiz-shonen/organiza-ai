rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.get('email', '')));
    }

    // Signed in with e-mail or Google; the anonymous accounts guests RSVP with do not count.
    function isAccountHolder() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function ownsEvent(event) {
      return request.auth != null && event.get('createdBy', '') == request.auth.uid;
    }

    // The owner and the collaborators manage items, guests and invitations.
    function managesEvent(event) {
      return ownsEvent(event) || (request.auth != null && request.auth.uid in event.get('collaborators', []));
    }

    function isSuperAdmin() {
      let email = request.auth.token.get('email', '');
      return request.auth != null && (email == 'luiz.gmr.dev@gmail.com' || email == 'jessica.calm.dev@gmail.com');
    }

    // Field checks for documents people write. The app validates the same fields with
    // value objects (src/app/core/value-objects); these limits are looser on purpose, so
    // the rules stop abuse without rejecting anything the app saves.

    // The fields this write sets or changes. On an update only those are checked, so an
    // older document with a value outside these rules can still be edited.
    function changedKeys() {
      return resource == null
          ? request.resource.data.keys()
          : request.resource.data.diff(resource.data).affectedKeys();
    }

    function changes(key) {
      return key in changedKeys();
    }

    // Text up to `max` characters with no markup characters (< > { }). Empty is allowed.
    function isPlainText(value, max) {
      return value is string && value.size() <= max && !value.matches('(?s).*[<>{}].*');
    }

    // Plain text that is not empty.
    function isFilledText(value, max) {
      return isPlainText(value, max) && value.size() > 0;
    }

    // Empty, or 10 to 20 characters of digits and phone punctuation.
    function isPhoneOrEmpty(value) {
      return value is string && (value == '' || value.matches('[0-9 ()+.-]{10,20}'));
    }

    function isOptionalString(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function isRelationship(value) {
      return value in ['spouse', 'child', 'parent', 'grandparent', 'sibling', 'relative', 'pet', 'other'];
    }

    // Amigo oculto: one document per secret link, written by the event owner when drawing.
    // Anyone holding the token reads it, signed in or not; nobody can list them. A link of a
    // participant with an account (`giverUid`) opens only in that account, so a forwarded link
    // shows nothing; the event owner still reads it, to see whether it was opened. A missing
    // document passes, so the page can tell "not found" from "not your link".
    // A link opens once: opening stamps `openedAt` and erases whom the person drew, and
    // that change is allowed once only, to anyone holding the token (or its account).
    match /secretSantaReveals/{token} {
      allow get: if resource == null
                 || isRevealHolder()
                 || ownsEvent(eventData(resource.data.get('eventId', '')));
      allow list: if false;
      allow update: if isRevealHolder()
                    && resource.data.get('openedAt', null) == null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['openedAt', 'receiverName', 'receiverGiftOptions'])
                    && request.resource.data.get('openedAt', null) is string
                    && request.resource.data.openedAt.size() <= 40
                    && request.resource.data.get('receiverName', null) == ''
                    && request.resource.data.get('receiverGiftOptions', null) == [];
      allow create: if request.resource.data.get('eventId', '') is string
                    && ownsEvent(eventData(request.resource.data.get('eventId', '')))
                    && isValidSecretSantaReveal();
      allow delete: if ownsEvent(eventData(resource.data.eventId));

      function isRevealHolder() {
        let owner = resource.data.get('giverUid', null);
        return owner == null || (request.auth != null && request.auth.uid == owner);
      }

      function isValidSecretSantaReveal() {
        let data = request.resource.data;
        return data.keys().hasOnly(['eventId', 'eventTitle', 'eventDate', 'giverName', 'giverUid',
                                    'receiverName', 'receiverGiftOptions', 'createdAt'])
            && isOptionalString(data.get('giverUid', null), 128)
            && isOptionalString(data.get('eventTitle', null), 200)
            && isOptionalString(data.get('eventDate', null), 40)
            && isFilledText(data.get('giverName', null), 120)
            && isFilledText(data.get('receiverName', null), 120)
            && data.get('receiverGiftOptions', []) is list
            && data.get('receiverGiftOptions', []).size() <= 10;
      }
    }

    match /admins/{email} {
      allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.token.get('email', '') == email);
    }

    // The name others see for an account, and nothing else: events show their organizer by
    // `createdBy` through it. Anyone reads it; only the account writes it.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['name', 'photoURL', 'updatedAt'])
                            && isFilledText(request.resource.data.get('name', null), 120)
                            && isOptionalString(request.resource.data.get('photoURL', null), 2048)
                            && isOptionalString(request.resource.data.get('updatedAt', null), 40);
    }

    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && isValidUser();

      // displayName and name may be null: they come from the Google account.
      function isValidUser() {
        let data = request.resource.data;
        return (!changes('displayName') || data.get('displayName', null) == null
                  || isFilledText(data.get('displayName', null), 120))
            && (!changes('name') || data.get('name', null) == null
                  || isFilledText(data.get('name', null), 120))
            && (!changes('phone') || isPhoneOrEmpty(data.get('phone', null)))
            && (!changes('email') || isOptionalString(data.get('email', null), 254))
            && (!changes('photoURL') || isOptionalString(data.get('photoURL', null), 2048))
            && (!changes('themePref') || data.get('themePref', null) in ['light', 'dark', 'system'])
            && (!changes('invitedEvents')
                  || (data.get('invitedEvents', null) is list && data.get('invitedEvents', null).size() <= 500))
            && (!changes('declinedEvents')
                  || (data.get('declinedEvents', null) is list && data.get('declinedEvents', null).size() <= 500))
            && (!changes('savedCompanions')
                  || (data.get('savedCompanions', null) is list && data.get('savedCompanions', null).size() <= 50))
            && (!changes('rsvpEvents')
                  || (data.get('rsvpEvents', null) is list && data.get('rsvpEvents', null).size() <= 500));
      }

      // In-app notifications. The member reads, marks as read and dismisses them. The owner of
      // an event writes one amigo oculto notice per event (`secret-santa_{eventId}`), for a
      // participant who has an account, pointing to their secret link.
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if (request.auth != null && request.auth.uid == uid
                          && changedKeys().hasOnly(['readAt']))
                      || isSecretSantaNotice()
                      || isOwnCollaboratorRecord();
        allow create: if isSecretSantaNotice() || isOwnCollaboratorRecord();

        // The member's own line in their history: an invite to help organise they answered.
        function isOwnCollaboratorRecord() {
          let data = request.resource.data;
          return request.auth != null
              && request.auth.uid == uid
              && data.keys().hasOnly(['kind', 'eventId', 'eventTitle', 'title', 'body',
                                      'actionLabel', 'actionUrl', 'createdAt', 'readAt'])
              && data.get('kind', '') == 'collaborator'
              && data.get('eventId', '') is string
              && notificationId == 'collaborator_' + data.get('eventId', '')
              && isOptionalString(data.get('eventTitle', null), 200)
              && isFilledText(data.get('title', null), 200)
              && isFilledText(data.get('body', null), 500)
              && isFilledText(data.get('actionLabel', null), 60)
              && data.get('actionUrl', '') == '/evento/' + data.get('eventId', '')
              && data.get('createdAt', null) is string;
        }

        function isSecretSantaNotice() {
          let data = request.resource.data;
          return request.auth != null
              && data.keys().hasOnly(['kind', 'eventId', 'eventTitle', 'title', 'body',
                                      'actionLabel', 'actionUrl', 'createdAt', 'readAt'])
              && data.get('kind', '') == 'secret-santa'
              && data.get('eventId', '') is string
              && notificationId == 'secret-santa_' + data.get('eventId', '')
              && ownsEvent(eventData(data.get('eventId', '')))
              && isOptionalString(data.get('eventTitle', null), 200)
              && isFilledText(data.get('title', null), 200)
              && isFilledText(data.get('body', null), 500)
              && isFilledText(data.get('actionLabel', null), 60)
              && data.get('actionUrl', '') is string
              && data.get('actionUrl', '').matches('/amigo-oculto/[A-Za-z0-9_-]{8,80}')
              && data.get('createdAt', null) is string
              && data.get('readAt', 'x') == null;
        }
      }

      match /family/{memberId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid && isValidFamilyMember();

        function isValidFamilyMember() {
          let data = request.resource.data;
          return (resource != null || data.keys().hasAll(['name', 'relationship']))
              && (!changes('name') || isFilledText(data.get('name', null), 120))
              && (!changes('relationship') || isRelationship(data.get('relationship', null)))
              && (!changes('phone') || isPhoneOrEmpty(data.get('phone', null)));
        }
      }
    }

    // Collection group query for pending invitations
    match /{path=**}/invitations/{email} {
      allow read: if request.auth != null && (
        request.auth.token.get('email', '').lower() == email.lower()
        || (resource != null && resource.data.get('invitedEmail', '').lower() == request.auth.token.get('email', '').lower())
      );
    }

    // Collection group query for the events a member answered (UserService.getAttendedEvents):
    // only their own guest documents.
    match /{path=**}/guests/{guestId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Events are private. Anyone with the invite link reads that one event; listing returns
    // only the events the account owns or helps organize, never all events of the owner.
    // Any account holder creates events they own; the owner edits, cancels and deletes; an
    // invited account adds itself to the collaborators.
    match /events/{eventId} {
      allow get: if true;
      allow list: if isAdmin() || isSuperAdmin()
                  || (request.auth != null
                      && (resource.data.createdBy == request.auth.uid
                          || request.auth.uid in resource.data.collaborators));
      allow create: if isValidEvent()
                    && (isAdmin()
                        || (isAccountHolder() && request.resource.data.get('createdBy', '') == request.auth.uid));
      allow update: if isValidEvent()
                    && (isAdmin()
                        || (ownsEvent(resource.data) && !changes('createdBy'))
                        || isJoiningByInvitation()
                        || isLeavingCollaboration());
      allow delete: if isAdmin() || ownsEvent(resource.data);

      // "Sair da colaboração": a collaborator removes only their own uid, nothing else.
      function isLeavingCollaboration() {
        return isAccountHolder()
            && request.auth.uid in resource.data.get('collaborators', [])
            && changedKeys().hasOnly(['collaborators', 'updatedAt'])
            && request.resource.data.get('collaborators', []).toSet()
                 == resource.data.get('collaborators', []).toSet().difference([request.auth.uid].toSet());
      }

      // claimPendingInvitations: the invited account adds only its own uid, while the
      // invitation for its e-mail still exists (the same batch deletes it).
      function isJoiningByInvitation() {
        let email = request.auth.token.get('email', '').lower();
        return isAccountHolder()
            && email != ''
            && exists(/databases/$(database)/documents/events/$(eventId)/invitations/$(email))
            && changedKeys().hasOnly(['collaborators', 'updatedAt'])
            && request.resource.data.get('collaborators', []).toSet()
                 == resource.data.get('collaborators', []).toSet().union([request.auth.uid].toSet());
      }

      // Size limits only: admins write events, and older ones may hold any text.
      function isValidEvent() {
        let data = request.resource.data;
        return (!changes('title') || isFilledText(data.get('title', null), 200))
            && (!changes('category') || isOptionalString(data.get('category', null), 60))
            && (!changes('description') || isOptionalString(data.get('description', null), 2000))
            && (!changes('endDate') || data.get('endDate', null) == null
                || (data.endDate is string && data.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
            && (!changes('location') || isOptionalString(data.get('location', null), 500))
            && (!changes('pixKey') || isOptionalString(data.get('pixKey', null), 77))
            && (!changes('pixPurpose') || isOptionalString(data.get('pixPurpose', null), 300))
            && (!changes('secretSantaRules') || isOptionalString(data.get('secretSantaRules', null), 500))
            && (!changes('secretSanta') || isSecretSantaSettings(data.get('secretSanta', null)))
            && (!changes('requireApproval') || data.get('requireApproval', null) is bool)
            && (!changes('addressDetails') || isAddressDetails(data.get('addressDetails', null)))
            && (!changes('mapLocation') || isMapLocation(data.get('mapLocation', null)));
      }

      // CEP, street, number, neighbourhood and city, plus the optional complement ("Km 12")
      // and "Como chegar" directions typed for places a map does not find well.
      function isAddressDetails(value) {
        return value is map
            && value.keys().hasOnly(['cep', 'address', 'number', 'neighborhood', 'city',
                                     'complement', 'directions'])
            && isOptionalString(value.get('cep', null), 9)
            && isOptionalString(value.get('address', null), 200)
            && isOptionalString(value.get('number', null), 7)
            && isOptionalString(value.get('neighborhood', null), 120)
            && isOptionalString(value.get('city', null), 120)
            && isOptionalString(value.get('complement', null), 80)
            && isOptionalString(value.get('directions', null), 300);
      }

      // "Localização no mapa": a pin (latitude, longitude and the place name) or a link, and
      // only to Google Maps or Waze, so the invite never sends guests to another site.
      function isMapLocation(value) {
        return value == null
            || (value is map
                && value.keys().hasOnly(['lat', 'lng', 'label'])
                && value.get('lat', null) is number && value.lat >= -90 && value.lat <= 90
                && value.get('lng', null) is number && value.lng >= -180 && value.lng <= 180
                && isOptionalString(value.get('label', null), 80))
            || (value is map
                && value.keys().hasOnly(['url'])
                && value.get('url', null) is string
                && value.url.size() <= 500
                && value.url.matches('https://(maps[.]app[.]goo[.]gl/|goo[.]gl/maps/|(www[.])?google[.]com([.]br)?/maps[/?]|maps[.]google[.]com([.]br)?/|(www[.]|ul[.])?waze[.]com/)[^ <>"]*'));
      }

      // "Vai ter amigo oculto?", "Incluir opções de presente", how many per person (1 to 10) and
      // whether guests may still join from the invite (`selfJoin`, missing means open).
      function isSecretSantaSettings(value) {
        return value is map
            && value.keys().hasOnly(['enabled', 'giftOptions', 'maxGiftOptions', 'selfJoin', 'drawDate', 'drawnAt'])
            && (!('drawDate' in value)
                || (value.drawDate is string && value.drawDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
            && isOptionalString(value.get('drawnAt', null), 40)
            && value.get('enabled', false) is bool
            && value.get('giftOptions', false) is bool
            && value.get('selfJoin', true) is bool
            && (!('maxGiftOptions' in value)
                || (value.maxGiftOptions is int
                    && value.maxGiftOptions >= 1
                    && value.maxGiftOptions <= 10));
      }

      // Amigo oculto participants: names and phones, so only the owner and collaborators read
      // the list. A guest also writes, reads and removes the entries they joined from the invite
      // (`rsvp_{uid}…`: themself, relatives and companions): joining while sign-ups are open,
      // leaving at any time until the draw (or the day set for it).
      match /secretSantaParticipants/{participantId} {
        allow read, delete: if isAdmin() || managesEvent(eventData(eventId));
        allow create, update: if (isAdmin() || managesEvent(eventData(eventId)))
                              && isValidSecretSantaParticipant()
                              && !changesGuestEntry();
        allow get: if isOwnRsvpEntry();
        allow delete: if isOwnRsvpEntry() && isBeforeDraw();
        allow create, update: if isOwnRsvpEntry()
                              && isSelfJoinOpen()
                              && isValidSecretSantaParticipant()
                              && request.resource.data.get('joinedBy', '') == request.auth.uid
                              && !changes('distinctFrom');

        // An entry tied to a guest (joined from the invite, or a confirmed guest's) is theirs:
        // organizers may take it out, tell it apart or link it ("Juntar"), never change it.
        // The organizer's own entry ("Participar também", `guestId` their uid) stays theirs to edit.
        function changesGuestEntry() {
          return resource != null
              && (resource.data.get('joinedBy', '') != '' || resource.data.get('guestId', '') != '')
              && resource.data.get('guestId', '') != request.auth.uid
              && !changedKeys().hasOnly(['distinctFrom', 'guestId'])
              && !takesPhoneFromMerged();
        }

        // "Juntar", keeping the phone the organizer typed: only that phone, taken from the typed
        // entry (`mergedFrom`) that leaves the list in the same batch.
        function takesPhoneFromMerged() {
          let from = request.resource.data.get('mergedFrom', '');
          let typed = /databases/$(database)/documents/events/$(eventId)/secretSantaParticipants/$(from);
          return changedKeys().hasOnly(['phone', 'mergedFrom', 'guestId'])
              && from is string && from != '' && from != participantId
              && exists(typed)
              && !existsAfter(typed)
              && get(typed).data.get('joinedBy', '') == ''
              && get(typed).data.get('phone', '') == request.resource.data.get('phone', null);
        }

        // A missing document passes, so the guest can check whether they joined.
        function isOwnRsvpEntry() {
          return isAccountHolder()
              && participantId.matches('rsvp_' + request.auth.uid + '(_.+)?')
              && (resource == null || resource.data.get('joinedBy', '') == request.auth.uid);
        }

        // Not drawn yet and the draw day (midnight in Brasília, 03:00 UTC) not come.
        function isBeforeDraw() {
          let settings = eventData(eventId).get('secretSanta', {});
          let day = settings.get('drawDate', '');
          return settings.get('enabled', false) == true
              && !exists(/databases/$(database)/documents/events/$(eventId)/secretSanta/draw)
              && (day == ''
                  || request.time < timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]))
                                      + duration.value(3, 'h'));
        }

        // When the event asks for approval, a guest who confirmed (waiting or approved) joins;
        // the app counts the entry only once approved, and a refusal removes it.
        function isSelfJoinOpen() {
          let event = eventData(eventId);
          let settings = event.get('secretSanta', {});
          return isBeforeDraw()
              && settings.get('selfJoin', true) != false
              && (event.get('requireApproval', false) != true
                  || exists(/databases/$(database)/documents/events/$(eventId)/guests/$(request.auth.uid)));
        }

        function isValidSecretSantaParticipant() {
          let data = request.resource.data;
          return data.keys().hasOnly(['name', 'phone', 'giftOptions', 'note', 'guestId', 'joinedBy', 'distinctFrom', 'mergedFrom', 'createdAt'])
              && (!changes('note') || isPlainText(data.get('note', null), 200))
              && (resource != null || data.keys().hasAll(['name', 'phone', 'giftOptions']))
              && (!changes('name') || isFilledText(data.get('name', null), 120))
              && (!changes('phone') || isPhoneOrEmpty(data.get('phone', null)))
              && (!changes('giftOptions')
                    || (data.get('giftOptions', null) is list && data.get('giftOptions', null).size() <= 10))
              && (!changes('guestId') || isOptionalString(data.get('guestId', null), 200))
              // Nobody moves an entry to another account; a guest sets their own uid (above).
              && (!changes('joinedBy') || (resource == null && data.get('joinedBy', '') == request.auth.uid))
              && (!changes('distinctFrom')
                    || (data.get('distinctFrom', null) is list && data.get('distinctFrom', null).size() <= 50))
              && (!changes('createdAt') || isOptionalString(data.get('createdAt', null), 40));
        }
      }

      // The amigo oculto as guests see it: the same ids as the participants, only the name and
      // the gift options (no phones). Any signed-in account reads it. Organizers write any entry;
      // a guest writes only their own (`rsvp_{uid}…`), in the same batch as the participant entry.
      match /secretSantaRoster/{participantId} {
        allow read: if isAdmin() || isAccountHolder();
        allow create, update: if (isAdmin() || managesEvent(eventData(eventId)))
                              && isValidRosterEntry()
                              && mirrorsGuestEntry();
        allow delete: if isAdmin() || managesEvent(eventData(eventId));
        allow create, update: if isOwnRosterEntry(true) && isValidRosterEntry();
        allow delete: if isOwnRosterEntry(false);

        // Writing: the participant entry exists after the batch and is this account's. Deleting:
        // it is gone after the batch, or still this account's.
        function isOwnRosterEntry(writing) {
          let participant = /databases/$(database)/documents/events/$(eventId)/secretSantaParticipants/$(participantId);
          return isAccountHolder()
              && participantId.matches('rsvp_' + request.auth.uid + '(_.+)?')
              && (existsAfter(participant)
                    ? getAfter(participant).data.get('joinedBy', '') == request.auth.uid
                    : !writing);
        }

        // An organizer's copy of a guest's entry carries that entry's own name and ideas.
        function mirrorsGuestEntry() {
          let participant = /databases/$(database)/documents/events/$(eventId)/secretSantaParticipants/$(participantId);
          return !existsAfter(participant) || mirrors(getAfter(participant).data);
        }

        function mirrors(entry) {
          return (entry.get('joinedBy', '') == '' && entry.get('guestId', '') == '')
              || (request.resource.data.get('name', null) == entry.get('name', '')
                  && request.resource.data.get('giftOptions', null) == entry.get('giftOptions', [])
                  && request.resource.data.get('note', '') == entry.get('note', ''));
        }

        function isValidRosterEntry() {
          let data = request.resource.data;
          return data.keys().hasOnly(['name', 'giftOptions', 'note', 'createdAt'])
              && (!changes('note') || isPlainText(data.get('note', null), 200))
              && isFilledText(data.get('name', null), 120)
              && data.get('giftOptions', null) is list && data.get('giftOptions', null).size() <= 10
              && (!changes('createdAt') || isOptionalString(data.get('createdAt', null), 40));
        }
      }

      // The latest amigo oculto draw holds every secret link; only the owner sends them.
      match /secretSanta/{docId} {
        // Drawing (the first time or again) waits for the draw day chosen for the event, from
        // midnight in Brasília (03:00 UTC); a new link for one person changes no drawnAt.
        function isDrawDayReached() {
          let day = eventData(eventId).get('secretSanta', {}).get('drawDate', '');
          return day == ''
              || request.time >= timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]))
                                    + duration.value(3, 'h');
        }

        function drawsNow() {
          return resource == null
              || request.resource.data.get('drawnAt', null) != resource.data.get('drawnAt', null);
        }

        allow read, delete: if ownsEvent(eventData(eventId));
        allow create, update: if ownsEvent(eventData(eventId))
                              && (!drawsNow() || isDrawDayReached());
      }

      // Who each collaborator is (their e-mail), for the organizers' "Colaboradores" list: written
      // by the collaborator themself, only while they are one, with their own sign-in e-mail.
      match /collaborators/{uid} {
        allow read: if isAdmin() || managesEvent(eventData(eventId));
        allow create, update: if request.auth != null
                              && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
                              && request.resource.data.email == request.auth.token.get('email', '').lower()
                              && isOptionalString(request.resource.data.get('updatedAt', null), 40)
                              && uid in getAfter(/databases/$(database)/documents/events/$(eventId)).data.get('collaborators', []);
        allow delete: if isAdmin() || ownsEvent(eventData(eventId)) || (request.auth != null && request.auth.uid == uid);
      }

      // Invitations subcollection: the owner invites, the invited user reads and claims
      match /invitations/{email} {
        allow read: if isAdmin() || managesEvent(eventData(eventId)) || (request.auth != null && request.auth.token.get('email', '').lower() == email.lower());
        allow create, update: if isAdmin() || ownsEvent(eventData(eventId));
        allow delete: if isAdmin() || ownsEvent(eventData(eventId)) || (request.auth != null && request.auth.token.get('email', '').lower() == email.lower());
      }

      // Guests subcollection: public read, validated anonymous write
      match /guests/{guestId} {
        allow read: if true;
        // "Adicionar alguém à mão": the organizers also put people on the list themselves.
        allow create: if isAdmin()
                      || (isPrimaryRsvp() && waitsForApproval() && !addedByOrganizer())
                      || (isLinkedFamilyRsvp() && !addedByOrganizer())
                      || (managesEvent(eventData(eventId)) && isManualGuest()
                          && request.resource.data.addedBy == request.auth.uid);
        // Only organizers approve: a guest never changes `approved` on their own answer. Someone
        // added by hand stays a valid hand-added entry, with who added them kept.
        allow update: if isAdmin()
                      || (managesEvent(eventData(eventId))
                          && (!('addedBy' in resource.data)
                              || (isManualGuest() && !changes('addedBy'))))
                      || (
                        request.auth != null
                        && !changes('approved')
                        && !changes('addedBy')
                        && ((resource.data.uid == request.auth.uid && isPrimaryRsvp())
                            || (resource.data.primaryGuestId == request.auth.uid && isLinkedFamilyRsvp()))
                      );

        // "Aprovar quem confirma pelo link": a new answer starts as waiting (`approved: false`).
        function waitsForApproval() {
          return !exists(/databases/$(database)/documents/events/$(eventId))
              || eventData(eventId).get('requireApproval', false) != true
              || request.resource.data.get('approved', null) == false;
        }
        allow delete: if isAdmin() || managesEvent(eventData(eventId)) || (
                        request.auth != null
                        && (resource.data.uid == request.auth.uid || resource.data.primaryGuestId == request.auth.uid)
                      );

        function addedByOrganizer() {
          return 'addedBy' in request.resource.data;
        }

        // Someone the organizers typed in: no account (`uid`), a name, an optional WhatsApp and
        // up to 10 companions, confirmed, and the uid of the organizer who added them.
        function isManualGuest() {
          let data = request.resource.data;
          return data.keys().hasOnly(['name', 'phone', 'companions', 'companionsCount',
                                      'isConfirmed', 'confirmedAt', 'addedBy', 'createdAt'])
              && data.keys().hasAll(['name', 'phone', 'companions', 'companionsCount',
                                     'isConfirmed', 'confirmedAt', 'addedBy'])
              && isFilledText(data.name, 120)
              && isPhoneOrEmpty(data.phone)
              && data.companions is list
              && data.companionsCount is int
              && data.companionsCount >= 0
              && data.companionsCount <= 10
              && data.companions.size() == data.companionsCount
              && data.isConfirmed == true
              && data.confirmedAt is string
              && data.addedBy is string;
        }

        function isPrimaryRsvp() {
          return isAccountHolder()
              && request.resource.data.keys().hasAll(['name', 'phone', 'companionsCount', 'uid'])
              && request.resource.data.uid == request.auth.uid
              && isFilledText(request.resource.data.name, 120)
              && isPhoneOrEmpty(request.resource.data.phone)
              && request.resource.data.phone.size() >= 10
              && request.resource.data.companionsCount is int
              && request.resource.data.companionsCount >= 0
              && request.resource.data.companionsCount <= 10
              && (!request.resource.data.keys().hasAll(['companions'])
                  || (request.resource.data.companions is list
                      && request.resource.data.companions.size() == request.resource.data.companionsCount));
        }

        function isLinkedFamilyRsvp() {
          return isAccountHolder()
              && request.resource.data.keys().hasAll(['name', 'primaryGuestId', 'isConfirmed', 'confirmedAt'])
              && request.resource.data.primaryGuestId == request.auth.uid
              && isFilledText(request.resource.data.name, 120)
              && isPhoneOrEmpty(request.resource.data.get('phone', ''))
              && (!('relationship' in request.resource.data)
                  || isRelationship(request.resource.data.relationship))
              && request.resource.data.isConfirmed == true
              && request.resource.data.confirmedAt is string;
        }
      }

      // Declines: "Não poderei ir", one per account, with an optional message for the organizer.
      match /declines/{uid} {
        allow read: if isAdmin() || managesEvent(eventData(eventId))
                    || (request.auth != null && request.auth.uid == uid);
        allow create, update: if request.auth != null
                              && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly(['name', 'message', 'declinedAt'])
                              && isFilledText(request.resource.data.name, 120)
                              && isPlainText(request.resource.data.message, 300)
                              && request.resource.data.declinedAt is string;
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }

      // Claims: what each household brings. One document per account holder, written only by them.
      match /claims/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null
                              && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly(['name', 'entries', 'updatedAt'])
                              && isPlainText(request.resource.data.name, 120)
                              && request.resource.data.entries is list
                              && request.resource.data.entries.size() <= 100;
        allow delete: if isAdmin() || managesEvent(eventData(eventId)) || (request.auth != null && request.auth.uid == uid);
      }

      // Items subcollection: public read, the owner and collaborators manage, anyone claims
      match /items/{itemId} {
        allow read: if true;
        allow create, delete: if isAdmin() || managesEvent(eventData(eventId));
        allow update: if isAdmin() || managesEvent(eventData(eventId)) || (
                        request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])
                        && (
                          // Claiming
                          (resource.data.claimedBy == null && request.resource.data.claimedBy != null && request.resource.data.claimedBy.uid == request.auth.uid
                            && isPlainText(request.resource.data.claimedBy.get('name', ''), 120)
                            && isOptionalString(request.resource.data.claimedBy.get('phone', ''), 30))
                          // Unclaiming
                          || (resource.data.claimedBy != null && resource.data.claimedBy.uid == request.auth.uid && request.resource.data.claimedBy == null)
                        )
                      );
      }
    }
  }
}
